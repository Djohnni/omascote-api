NODE_ENV=staging
PORT=3000
PUBLIC_API_BASE_URL=https://api-staging.example.invalid

# PostgreSQL gerenciado. Defina no cofre do provedor, nunca neste arquivo.
DATABASE_URL=
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_CONNECTION_TIMEOUT_MS=5000

# Autenticacao e rede.
JWT_SECRET=
OMASCOTE_CORS_INCLUDE_PRODUCTION_ORIGINS=false
OMASCOTE_CORS_ORIGINS=https://staging.example.invalid
RADAR_TRUST_PROXY_HOPS=1

# O release sobe fechado. A ativacao do piloto exige autorizacao posterior.
RADAR_AMISTOSOS_ENABLED=false
RADAR_SEARCH_ENABLED=false
RADAR_INVITATIONS_ENABLED=false
RADAR_MATCH_CENTER_ENABLED=false
RADAR_MATCH_RESULTS_ENABLED=false
RADAR_MATCH_HISTORY_ENABLED=false
RADAR_REPUTATION_ENABLED=false
RADAR_MODERATION_ENABLED=false
RADAR_PROFILE_PRINT_IMPORT_ENABLED=false
RADAR_PILOT_ACCOUNT_ALLOWLIST=
RADAR_PILOT_CITY_IBGE_CODE=
RADAR_MODERATION_SLA_HOURS=24

# Segredos independentes. Gere valores diferentes no cofre do staging.
RADAR_INSTAGRAM_VERIFICATION_SECRET=
RADAR_SEARCH_CURSOR_SECRET=
RADAR_SEARCH_RATE_LIMIT_SECRET=
RADAR_INVITATIONS_SECURITY_SECRET=
RADAR_MATCH_RESULTS_SECURITY_SECRET=
RADAR_MATCH_HISTORY_CURSOR_SECRET=
RADAR_MATCH_HISTORY_RATE_LIMIT_SECRET=
RADAR_REPUTATION_SECURITY_SECRET=
RADAR_MODERATION_SECURITY_SECRET=
RADAR_METRICS_TOKEN=

# Observabilidade e retencao.
RADAR_METRICS_ENABLED=true
RADAR_TECHNICAL_RETENTION_DAYS=14
RADAR_RETENTION_BATCH_MAXIMUM=500
RELEASE_VERSION=
COMMIT_SHA=

# IA permanece desligada neste candidato.
OPENAI_API_KEY=
RADAR_PROFILE_PRINT_OPENAI_MODEL=
RADAR_PROFILE_PRINT_SECURITY_SECRET=
RADAR_PROFILE_PRINT_SAFETY_IDENTIFIER_SECRET=
